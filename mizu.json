{
  "info": {
    "name": "Mizu",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "url", "value": "http://localhost:3000" },
    { "key": "key", "value": "" },
    { "key": "addr", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"dev\",\n  \"password\": \"123\"\n}" },
        "url": { "raw": "{{url}}/api/developer/register", "host": ["{{url}}"], "path": ["api","developer","register"] }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"dev\",\n  \"password\": \"123\"\n}" },
        "url": { "raw": "{{url}}/api/developer/login", "host": ["{{url}}"], "path": ["api","developer","login"] }
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-api-key", "value": "{{key}}" }],
        "url": { "raw": "{{url}}/api/developer/me", "host": ["{{url}}"], "path": ["api","developer","me"] }
      }
    },
    {
      "name": "Buat Wallet",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{key}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "{{url}}/api/v1/wallet/create", "host": ["{{url}}"], "path": ["api","v1","wallet","create"] }
      }
    },
    {
      "name": "Saldo",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-api-key", "value": "{{key}}" }],
        "url": {
          "raw": "{{url}}/api/v1/wallet/balance?address={{addr}}",
          "host": ["{{url}}"], "path": ["api","v1","wallet","balance"],
          "query": [{ "key": "address", "value": "{{addr}}" }]
        }
      }
    },
    {
      "name": "Info Wallet",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-api-key", "value": "{{key}}" }],
        "url": {
          "raw": "{{url}}/api/v1/wallet/info?address={{addr}}",
          "host": ["{{url}}"], "path": ["api","v1","wallet","info"],
          "query": [{ "key": "address", "value": "{{addr}}" }]
        }
      }
    },
    {
      "name": "Riwayat",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-api-key", "value": "{{key}}" }],
        "url": {
          "raw": "{{url}}/api/v1/wallet/transactions?address={{addr}}&limit=10",
          "host": ["{{url}}"], "path": ["api","v1","wallet","transactions"],
          "query": [
            { "key": "address", "value": "{{addr}}" },
            { "key": "limit", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "Mining Start",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{key}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"address\": \"{{addr}}\"\n}" },
        "url": { "raw": "{{url}}/api/v1/mining/start", "host": ["{{url}}"], "path": ["api","v1","mining","start"] }
      }
    },
    {
      "name": "Mining Stop",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{key}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"address\": \"{{addr}}\"\n}" },
        "url": { "raw": "{{url}}/api/v1/mining/stop", "host": ["{{url}}"], "path": ["api","v1","mining","stop"] }
      }
    },
    {
      "name": "Mining Status",
      "request": {
        "method": "GET",
        "header": [{ "key": "x-api-key", "value": "{{key}}" }],
        "url": {
          "raw": "{{url}}/api/v1/mining/status?address={{addr}}",
          "host": ["{{url}}"], "path": ["api","v1","mining","status"],
          "query": [{ "key": "address", "value": "{{addr}}" }]
        }
      }
    },
    {
      "name": "Mining Claim",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{key}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"address\": \"{{addr}}\"\n}" },
        "url": { "raw": "{{url}}/api/v1/mining/claim", "host": ["{{url}}"], "path": ["api","v1","mining","claim"] }
      }
    },
    {
      "name": "Transfer",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fromAddress\": \"{{addr}}\",\n  \"toAddress\": \"mizu...\",\n  \"amount\": 0.5,\n  \"memo\": \"test\"\n}"
        },
        "url": { "raw": "{{url}}/api/v1/transfer", "host": ["{{url}}"], "path": ["api","v1","transfer"] }
      }
    },
    {
      "name": "Transfer Batch",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-api-key", "value": "{{key}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fromAddress\": \"{{addr}}\",\n  \"transfers\": [\n    { \"toAddress\": \"mizu...\", \"amount\": 0.1 },\n    { \"toAddress\": \"mizu...\", \"amount\": 0.25 }\n  ]\n}"
        },
        "url": { "raw": "{{url}}/api/v1/transfer/batch", "host": ["{{url}}"], "path": ["api","v1","transfer","batch"] }
      }
    },
    {
      "name": "Search",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{url}}/api/explorer/search?query={{addr}}",
          "host": ["{{url}}"], "path": ["api","explorer","search"],
          "query": [{ "key": "query", "value": "{{addr}}" }]
        }
      }
    },
    {
      "name": "Stats",
      "request": {
        "method": "GET",
        "url": { "raw": "{{url}}/api/explorer/stats", "host": ["{{url}}"], "path": ["api","explorer","stats"] }
      }
    },
    {
      "name": "Latest TX",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{url}}/api/explorer/transactions/latest?limit=20",
          "host": ["{{url}}"], "path": ["api","explorer","transactions","latest"],
          "query": [{ "key": "limit", "value": "20" }]
        }
      }
    },
    {
      "name": "Top Wallets",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{url}}/api/explorer/top-wallets?limit=10",
          "host": ["{{url}}"], "path": ["api","explorer","top-wallets"],
          "query": [{ "key": "limit", "value": "10" }]
        }
      }
    }
  ]
}